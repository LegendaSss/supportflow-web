# SupportFlow Web — Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=supportflow
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/supportflow?schema=public

# Telegram Bot (SupportFlow bot token)
TELEGRAM_BOT_TOKEN=

# VPN Bot (основной VPN бот)
VPN_BOT_TOKEN=

# Remnawave Panel
REMNAWAVE_URL=https://your-remnawave-panel.example.com
REMNAWAVE_PUBLIC_URL=https://your-remnawave-panel.example.com
REMNAWAVE_API_KEY=

# JWT Secret for auth
JWT_SECRET=change-this-in-production
